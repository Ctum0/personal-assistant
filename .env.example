# Sofia Personal AI Companion Environment Variables

# Sofia Single-User Bearer Token (Shared Bearer Secret for /unlock and /api/* routes; if unset, open auth for local dev)
SOFIA_AUTH_TOKEN=your-secret-sofia-token
SOFIA_API_TOKEN=your-secret-sofia-token

# LiteLLM Proxy / AI Inference (Fallback/Auxiliary)
LITELLM_BASE_URL=https://ai-proxy.zenova.services/v1
LITELLM_API_KEY=your-litellm-proxy-key
LITELLM_MODEL=deepseek-v4.1-flash

# Hermes Execution Engine (Authoritative Brain)
# Production default: https://hermes.ctum.org
HERMES_API_URL=https://hermes.ctum.org
HERMES_API_KEY=your-hermes-api-key
HERMES_SESSION_KEY=sofia-primary
HERMES_ENABLED=true
HERMES_TIMEOUT_MS=120000

# Edge TTS (Unlimited free default)
EDGE_TTS_VOICE=en-US-AvaNeural
EDGE_TTS_PITCH=+25Hz
EDGE_TTS_RATE=+6%

# ElevenLabs Text-to-Speech (Optional, budget-enforced)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Device Collector / Workstation Telemetry
DEVICE_TOKEN=your-device-collector-token

# VPS Proactive Cron Secret
CRON_SECRET=your-vps-cron-secret

# Telegram Push Notifications for Proactive Messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
